# All variables are optional. Without them Relay MKE runs fully in demo mode:
# in-memory store, rule-based AI, mock SMS.

# OpenAI (intake structuring, funder narrative, Field Guide Q&A). Falls back to rules if unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase (persistent store). Falls back to in-memory seed data if unset.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Twilio (real SMS). Falls back to mock SMS + /api/sms/simulate if unset.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Phone line — ElevenLabs agent (see README "Phone line"). All optional.
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=          # from Agents → Settings → Post-call webhooks
VOICE_TOOL_SECRET=                  # any random string; sent by the agent as x-relay-secret
PUBLIC_BASE_URL=                    # https tunnel to this app, e.g. https://xxx.trycloudflare.com
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=    # printed by tools/voice/create-agent.mjs; enables the web-call widget on /r
NEXT_PUBLIC_RELAY_PHONE=            # e.g. (414) 555-0100 — shows a "Call Relay" button on /r
VOICE_NOTICE=                       # robotic pre-roll; default: "This call is answered by ComForce Milwaukee's Relay line and may be recorded. Please hold."
ELEVENLABS_TWILIO_INBOUND_URL=      # the voice URL ElevenLabs sets on your Twilio number after import
